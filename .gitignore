.DS_Store
__pycache__/
*.pyc
*.tgz

# graphify: the graph, the report and the manifest are committed — the next
# harvest queries the first two, and the third is what makes `--update`
# incremental instead of a full rebuild. The working sidecars are not: the
# semantic cache is content-keyed and rebuildable, cost.json is this machine's
# token accounting, and graph.html is a 1 MB re-render of graph.json.
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/cost.json
graphify-out/graph.html

# agent-sync run state — per-machine, never shared
.agent-sync/

# agent-sync — local credentials and run state, never committed
.env.agent-sync
